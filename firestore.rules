rules_version = '2';
// กฎสิทธิ์ของเว็บใบสั่งงานฝึกงาน — วางทั้งไฟล์นี้ใน Firebase console → Firestore Database → Rules แล้วกด Publish
// pending = ล็อกอินแล้วแต่แอดมินยังไม่อนุมัติ: อ่านได้แค่ข้อมูลของตัวเอง
// แอดมินที่เป็นนักศึกษาด้วย: สั่งงาน แก้ใบสั่งงาน และลงแผนไม่ได้ จนกว่าจะปลดล็อกด้วยรหัสใช้ครั้งเดียว (ครั้งละ 1 ชั่วโมง)
//   และตรวจงานใครไม่ได้เลย รหัสเก็บไว้ที่ชิเอล ในไฟล์นี้มีแค่ค่า SHA-256 ของรหัส
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function role() {
      return signedIn() && exists(userPath(request.auth.uid)) ? profile().role : 'none';
    }
    function approved() { return role() in ['admin', 'supervisor', 'student']; }
    function admin() { return role() == 'admin'; }
    function internAdmin() { return admin() && profile().get('isStudent', false) == true; }
    function unlocked() {
      return profile().get('assignerUntil', null) is timestamp && profile().assignerUntil > request.time;
    }
    // assign work and edit the plan: supervisors, admins who are not interns, intern-admins with an open unlock
    function assigner() { return role() == 'supervisor' || (admin() && (!internAdmin() || unlocked())); }
    // pass or send back work: never an intern
    function reviewer() { return role() == 'supervisor' || (admin() && !internAdmin()); }
    // an intern-admin never touches a work order he is on, even while unlocked
    function notMine(data) { return !internAdmin() || !(request.auth.uid in data.assignees); }
    function task(tid) { return get(/databases/$(database)/documents/tasks/$(tid)).data; }
    function isAssignee(tid, uid) { return uid in task(tid).assignees; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }
    // SHA-256 (hex) of the one-time unlock codes
    function unlockHashes() { return [
      '3cc15ba87c91da6643059e7311f996ca2833b174e0c0ff61d96bfbbe9d2e5f2a',
      '69d56a6c1f34cd2b1f99c92ed2f2a79a7e44d208f4311847353888f072d3e7bb',
      'd186b5a5ab6e85e490cd2a69e628f447b73e33f944937ec20922f3f5bed66e14',
      'f7e0794839da34d3acc48db38b3d72bb1ae552b3805d310bb07dd630ea349273',
      'e1a2ba6af81787b1a79a90e9826d1797fde200ba44509e10a56eda0a1b6e58ab',
      'a6a5b9a7f53057921523cccef0f290c6249dbfff6dffc8b1554855874e708661',
      '4b936479a9059c4501c3c2050e658074554af148aa5b1fb59855ae5002a07622',
      '4fc21c4ae25acd8482ec1eb36b7efa9ba45cc581110a79f747d867d55d107821',
      '27466b1244e2eea395b43df71cfd4aca74e037367efd103f205a414c028e2d7e',
      'cc3fad3982a5ba47cd9948f9c5545169d2b1cb0eb7766257ae8429d871c3b1b5'
    ]; }
    // company staff (supervisors, admins who are not interns) and interns, read from a user document
    function staffDoc(d) { return d.role == 'supervisor' || (d.role == 'admin' && d.get('isStudent', false) == false); }
    function internDoc(d) { return d.role == 'student' || (d.role == 'admin' && d.get('isStudent', false) == true); }
    // an intern's พี่ที่ดูแล: up to five staff members, checked one by one (rules have no loops);
    // `mentor` is the one who signs the university form and must be one of them
    function staffAt(l, i) { return l.size() <= i || (l[i] is string && exists(userPath(l[i])) && staffDoc(get(userPath(l[i])).data)); }
    function okMentors(l) { return l is list && l.size() <= 5 && staffAt(l, 0) && staffAt(l, 1) && staffAt(l, 2) && staffAt(l, 3) && staffAt(l, 4); }
    function okSigner(d) {
      return d.get('mentor', null) == null || d.get('mentor', null) == '' || d.get('mentor', null) in d.get('mentors', []);
    }
    // older records kept a single `mentor`
    function mentorsOf(d) {
      return d.get('mentors', d.get('mentor', null) is string && d.get('mentor', '') != '' ? [d.get('mentor', '')] : []);
    }
    function mentorsChange(a, b) {
      let x = mentorsOf(a).toSet();
      let y = b.get('mentors', []).toSet();
      return x.difference(y).union(y.difference(x));
    }
    // the author may fix or take back a chat message or a comment for 15 minutes; a taken-back one keeps no text
    function msgEditOk() {
      return resource.data.by == request.auth.uid
        && resource.data.get('deleted', false) == false && resource.data.get('sys', false) == false
        && request.time < resource.data.at + duration.value(15, 'm')
        && request.resource.data.editedAt == request.time
        && ((onlyChanged(['text', 'editedAt']) && request.resource.data.text is string
              && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)
            || (onlyChanged(['text', 'deleted', 'editedAt']) && request.resource.data.deleted == true && request.resource.data.text == ''));
    }
    // who may comment on a work order: staff, the admin, and the interns on it
    function talker(tid) { return staffDoc(profile()) || admin() || isAssignee(tid, request.auth.uid); }
    // a private chat is always one staff member and one intern
    function chatPair(a, b) {
      let ua = get(userPath(a)).data;
      let ub = get(userPath(b)).data;
      return (staffDoc(ua) && internDoc(ub)) || (internDoc(ua) && staffDoc(ub));
    }

    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      // first sign-in: everyone starts as "pending"
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photo', 'role', 'isStudent', 'created']);
      allow update: if
        // admins manage other people; nobody changes their own role, and the unlock fields only change through a code
        (admin() && !changed().hasAny(['assignerUntil', 'lastUnlock'])
            && (uid != request.auth.uid || !changed().hasAny(['role', 'isStudent'])))
        // one-time bootstrap: whoever creates meta/admin in the same batch becomes admin (only while it does not exist yet)
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/meta/admin)
            && getAfter(/databases/$(database)/documents/meta/admin).data.uid == request.auth.uid
            && onlyChanged(['role', 'isStudent']) && request.resource.data.role == 'admin')
        // people may edit their own profile details, never their role; an intern also picks their พี่ที่ดูแล
        || (signedIn() && request.auth.uid == uid && approved()
            && onlyChanged(['name', 'nickname', 'studentId', 'major', 'faculty', 'position', 'mentor', 'mentors'])
            && (!changed().hasAny(['mentor', 'mentors'])
                || (internDoc(resource.data) && okMentors(request.resource.data.get('mentors', [])) && okSigner(request.resource.data))))
        // a supervisor adds or removes only himself among an intern's พี่ที่ดูแล; he may pick who signs
        // only when nobody does yet, or when he was the one signing
        || (role() == 'supervisor' && uid != request.auth.uid && internDoc(resource.data)
            && onlyChanged(['mentor', 'mentors'])
            && request.resource.data.get('mentors', []) is list && request.resource.data.get('mentors', []).size() <= 5
            && mentorsChange(resource.data, request.resource.data).hasOnly([request.auth.uid])
            && okSigner(request.resource.data)
            && (!changed().hasAny(['mentor'])
                || resource.data.get('mentor', null) == null || resource.data.get('mentor', null) == ''
                || resource.data.get('mentor', null) == request.auth.uid))
        // an intern-admin opens assigner mode for up to an hour by spending a fresh one-time code in the same batch
        || (signedIn() && request.auth.uid == uid && internAdmin()
            && onlyChanged(['assignerUntil', 'lastUnlock'])
            && request.resource.data.assignerUntil is timestamp
            && request.resource.data.assignerUntil > request.time
            && request.resource.data.assignerUntil < request.time + duration.value(75, 'm')
            && request.resource.data.lastUnlock is string
            && !exists(/databases/$(database)/documents/unlocks/$(request.resource.data.lastUnlock))
            && existsAfter(/databases/$(database)/documents/unlocks/$(request.resource.data.lastUnlock)))
        // locking again early is always allowed
        || (signedIn() && request.auth.uid == uid && onlyChanged(['assignerUntil']) && request.resource.data.assignerUntil == null)
        // self-registration with the team invite code (joins/{uid} in the same batch): staff fill a position, interns a student ID
        || (signedIn() && request.auth.uid == uid && resource.data.role == 'pending'
            && request.resource.data.role in ['student', 'supervisor']
            && request.resource.data.isStudent == (request.resource.data.role == 'student')
            && onlyChanged(['role', 'isStudent', 'name', 'nickname', 'position', 'studentId', 'major', 'faculty'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0
            && (request.resource.data.role == 'student'
                ? request.resource.data.get('studentId', '') is string && request.resource.data.get('studentId', '').size() > 0
                : request.resource.data.get('position', '') is string && request.resource.data.get('position', '').size() > 0)
            && !exists(/databases/$(database)/documents/joins/$(uid))
            && getAfter(/databases/$(database)/documents/joins/$(uid)).data.role == request.resource.data.role);
      allow delete: if admin() && uid != request.auth.uid;
    }

    // a used code stays here, so it can never be used again
    match /unlocks/{code} {
      allow read: if false;
      allow create: if signedIn() && internAdmin()
        && hashing.sha256(code).toHexString().lower() in unlockHashes()
        && request.resource.data.keys().hasOnly(['by', 'at', 'reason', 'until'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 300
        && request.resource.data.until == getAfter(userPath(request.auth.uid)).data.assignerUntil;
      allow update, delete: if false;
    }

    // invite codes for the two invite links (one for staff, one for interns); only the admin sees them
    match /meta/join {
      allow read, write: if admin();
    }
    // the code someone joined with; checked against meta/join and never readable
    match /joins/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'code', 'at'])
        && request.resource.data.role in ['student', 'supervisor']
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/meta/join)
        && request.resource.data.code == get(/databases/$(database)/documents/meta/join).data.get(request.resource.data.role, '#none#');
      allow update, delete: if false;
    }

    match /meta/admin {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /meta/counter {
      allow read: if approved();
      allow write: if assigner();
    }
    match /settings/{id} {
      allow read: if approved();
      allow write: if admin();
    }
    match /plans/{id} {
      allow read: if approved();
      allow write: if assigner();
    }

    match /tasks/{tid} {
      allow read: if approved();
      allow create: if assigner() && notMine(request.resource.data);
      allow update: if assigner() && notMine(resource.data) && notMine(request.resource.data);
      allow delete: if assigner() && notMine(resource.data);

      // one status document per intern: ack / submitted (approved only for tasks that need no review)
      match /progress/{uid} {
        allow read: if approved();
        allow delete: if assigner() && (!internAdmin() || uid != request.auth.uid);
        // assigners set other people's status; only reviewers pass or send back, never their own work
        allow create, update: if assigner() && (!internAdmin() || uid != request.auth.uid)
          && !(request.resource.data.s in ['approved', 'changes']);
        allow create, update: if reviewer() && uid != request.auth.uid;
        allow create, update: if approved() && isAssignee(tid, request.auth.uid)
          && (uid == request.auth.uid || (task(tid).mode == 'group' && isAssignee(tid, uid)))
          && request.resource.data.keys().hasOnly(['s', 'at'])
          && (request.resource.data.s in ['ack', 'submitted']
              || (request.resource.data.s == 'approved' && task(tid).needsReview == false));
      }

      match /subs/{sid} {
        allow read: if approved();
        allow create: if approved() && isAssignee(tid, request.auth.uid)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.for.hasAll([request.auth.uid])
          && (request.resource.data.review == null
              || (task(tid).needsReview == false && request.resource.data.review.decision == 'approved'));
        allow update: if reviewer() && !(request.auth.uid in resource.data.for);
        allow delete: if (assigner() && !(request.auth.uid in resource.data.for))
          || (resource.data.by == request.auth.uid && resource.data.review == null);
      }

      // ความเห็นในใบสั่งงาน
      match /comments/{id} {
        allow read: if approved();
        allow create: if approved() && talker(tid)
          && request.resource.data.keys().hasOnly(['by', 'text', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time;
        allow update: if approved() && msgEditOk();
        // only together with the work order itself
        allow delete: if assigner() && !existsAfter(/databases/$(database)/documents/tasks/$(tid));
      }
    }

    // one small summary per work order with comments (for the red dot); people only ever gains the writer
    match /talk/{tid} {
      allow read: if approved();
      allow create: if approved() && talker(tid)
        && request.resource.data.keys().hasOnly(['n', 'lastAt', 'lastBy', 'lastText', 'people'])
        && request.resource.data.n == 1 && request.resource.data.people == [request.auth.uid]
        && request.resource.data.lastBy == request.auth.uid && request.resource.data.lastAt == request.time
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140;
      allow update: if approved() && talker(tid)
        && request.resource.data.keys().hasOnly(['n', 'lastAt', 'lastBy', 'lastText', 'people'])
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140
        && request.resource.data.people.toSet().difference(resource.data.people.toSet()).hasOnly([request.auth.uid])
        && resource.data.people.toSet().difference(request.resource.data.people.toSet()).size() == 0
        && (
          // a new comment
          (request.resource.data.n == resource.data.n + 1 && request.resource.data.lastBy == request.auth.uid
            && request.resource.data.lastAt == request.time)
          // the writer of the last comment fixes or takes it back
          || (onlyChanged(['lastText']) && resource.data.lastBy == request.auth.uid));
      allow delete: if assigner() && !existsAfter(/databases/$(database)/documents/tasks/$(tid));
    }
    // when I last read the comments of each work order; mine alone
    match /seen/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // the whole team's statuses are read with one collection-group listener
    match /{path=**}/progress/{uid} {
      allow read: if approved();
    }

    match /attachments/{aid} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.by == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if assigner() || resource.data.by == request.auth.uid;
      allow update: if false;
    }

    // chats: a pair chat (one staff member + one intern, id "<uidA>_<uidB>") or a group (an auto id, with a staff host);
    // only the people in a chat can read or write it, the admin too is shut out
    function chatPath(cid) { return /databases/$(database)/documents/chats/$(cid); }
    function chatLine() {
      return request.resource.data.lastBy == request.auth.uid && request.resource.data.lastAt == request.time
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140;
    }
    // a new message line, and "seen" moved by its owner only
    function chatSummaryOk() {
      return (!changed().hasAny(['lastAt', 'lastText', 'lastBy']) || chatLine())
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasAny([request.auth.uid])
            || request.resource.data.seen[request.auth.uid] == request.time);
    }
    function groupShapeOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.members is list && d.members.size() >= 2 && d.members.size() <= 20
        && d.host in d.members;
    }
    match /chats/{cid} {
      allow get: if approved() && (request.auth.uid in cid.split('_') || request.auth.uid in resource.data.members);
      allow list: if approved() && request.auth.uid in resource.data.members;
      // pair: one staff member and one intern
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['members', 'lastAt', 'lastText', 'lastBy', 'seen'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && chatPair(request.resource.data.members[0], request.resource.data.members[1])
        && chatLine()
        && request.resource.data.seen.keys().hasOnly([request.auth.uid]);
      // group: anyone starts one, as long as a staff member (the host) is in it; never an id that looks like a pair
      allow create: if approved() && !cid.matches('.*_.*')
        && request.resource.data.keys().hasOnly(['kind', 'name', 'host', 'createdBy', 'members', 'lastAt', 'lastText', 'lastBy', 'seen'])
        && request.resource.data.kind == 'group'
        && groupShapeOk(request.resource.data)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && staffDoc(get(userPath(request.resource.data.host)).data)
        && chatLine()
        && request.resource.data.seen.keys().hasOnly([request.auth.uid]);
      allow update: if approved() && request.auth.uid in resource.data.members && (
        // a new message line and "seen"
        (onlyChanged(['lastAt', 'lastText', 'lastBy', 'seen']) && chatSummaryOk())
        // the writer of the last message fixes or takes it back: the preview follows
        || (onlyChanged(['lastText']) && resource.data.lastBy == request.auth.uid
            && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140)
        // staff in a group: rename, add or remove people, take over or hand over the host (to another staff member)
        || (resource.data.get('kind', 'pair') == 'group' && staffDoc(profile())
            && onlyChanged(['name', 'members', 'host', 'lastAt', 'lastText', 'lastBy', 'seen']) && chatSummaryOk()
            && groupShapeOk(request.resource.data)
            && (request.resource.data.host == resource.data.host || request.resource.data.host == request.auth.uid
                || staffDoc(get(userPath(request.resource.data.host)).data)))
        // anyone but the host leaves a group
        || (resource.data.get('kind', 'pair') == 'group' && request.auth.uid != resource.data.host
            && onlyChanged(['members', 'lastAt', 'lastText', 'lastBy'])
            && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
            && (!changed().hasAny(['lastAt', 'lastText', 'lastBy']) || chatLine())));
      allow delete: if false;

      match /msgs/{mid} {
        allow read: if approved()
          && (request.auth.uid in cid.split('_') || request.auth.uid in get(chatPath(cid)).data.members);
        allow create: if approved()
          && request.auth.uid in getAfter(chatPath(cid)).data.members
          && request.resource.data.keys().hasOnly(['by', 'text', 'at', 'sys'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && request.resource.data.get('sys', false) is bool;
        allow update: if approved() && request.auth.uid in get(chatPath(cid)).data.members && msgEditOk();
        allow delete: if false;
      }
    }

    match /activity/{id} {
      allow read: if approved();
      // also the entry written in the same batch as one's own registration
      allow create: if request.resource.data.by == request.auth.uid
        && (approved() || getAfter(userPath(request.auth.uid)).data.role in ['admin', 'supervisor', 'student']);
      allow update, delete: if false;
    }
  }
}
